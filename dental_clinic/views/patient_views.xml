<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_dental_patient_list" model="ir.ui.view">
        <field name="name">dental.patient.list</field>
        <field name="model">dental.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_id"/>
                <field name="first_name"/>
                <field name="middle_name"/>
                <field name="last_name"/>
                <field name="sex"/>
                <field name="birthdate"/>
                <field name="phone"/>
                <field name="city_id"/>
                <field name="class_id"/>
                <field name="comments"/>
            </list>
        </field>
    </record>

    <record id="view_dental_patient_search" model="ir.ui.view">
        <field name="name">dental.patient.search</field>
        <field name="model">dental.patient</field>
        <field name="arch" type="xml">
            <search>
                <field name="patient_id"/>
                <field name="first_name"/>
                <field name="middle_name"/>
                <field name="last_name"/>
                <field name="phone"/>
                <field name="email"/>
                <filter name="filter_male" string="Male" domain="[('sex', '=', 'male')]"/>
                <filter name="filter_female" string="Female" domain="[('sex', '=', 'female')]"/>
                <separator/>
                <filter name="group_by_class" string="Class" context="{'group_by': 'class_id'}"/>
                <filter name="group_by_city" string="City" context="{'group_by': 'city_id'}"/>
                <filter name="group_by_treating_doctor" string="Treating Doctor" context="{'group_by': 'treating_doctor_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_dental_patient_image_form" model="ir.ui.view">
        <field name="name">dental.patient.image.form</field>
        <field name="model">dental.patient.image</field>
        <field name="arch" type="xml">
            <form string="Patient Image">
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id" invisible="1"/>
                            <field name="category"/>
                            <field name="date"/>
                            <field name="name"/>
                        </group>
                    </group>
                    <field name="image" widget="image" options="{'size': [900, 900]}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dental_patient_form" model="ir.ui.view">
        <field name="name">dental.patient.form</field>
        <field name="model">dental.patient</field>
        <field name="arch" type="xml">
            <form class="dental_patient_form">
                <sheet>
                    <div class="dental_patient_header">
                        <field name="photo" widget="image" class="dental_patient_avatar" options="{'size': [80, 80]}" nolabel="1"/>
                        <div class="dental_patient_header_item dental_patient_number">
                            <span>Patient #</span>
                            <field name="patient_id" nolabel="1"/>
                        </div>
                        <div class="dental_patient_header_name">
                            <field name="name" readonly="1" nolabel="1"/>
                        </div>
                        <div class="dental_patient_header_item">
                            <span>Birthdate / Age</span>
                            <div class="dental_patient_inline_fields">
                                <field name="birthdate" nolabel="1"/>
                                <field name="age" readonly="1" nolabel="1"/>
                            </div>
                        </div>
                        <div class="dental_patient_header_item">
                            <span>Class</span>
                            <field name="class_id" nolabel="1"/>
                        </div>
                        <div class="dental_patient_header_item">
                            <span>Stage</span>
                            <field name="current_stage" widget="badge" nolabel="1"/>
                        </div>
                        <div class="dental_patient_header_item dental_patient_doctor">
                            <span>Treating Doctor</span>
                            <field name="treating_doctor_id" nolabel="1"/>
                        </div>
                    </div>

                    <div class="dental_gallery_counts">
                        <div class="dental_gallery_count"><span>All</span><field name="image_count_all" nolabel="1"/></div>
                        <div class="dental_gallery_count"><span>Start</span><field name="image_count_start" nolabel="1"/></div>
                        <div class="dental_gallery_count"><span>Progress</span><field name="image_count_progress" nolabel="1"/></div>
                        <div class="dental_gallery_count"><span>Retention</span><field name="image_count_retention" nolabel="1"/></div>
                        <div class="dental_gallery_count"><span>Models</span><field name="image_count_models" nolabel="1"/></div>
                        <div class="dental_gallery_count"><span>PAN</span><field name="image_count_pan" nolabel="1"/></div>
                        <div class="dental_gallery_count"><span>CEPH</span><field name="image_count_ceph" nolabel="1"/></div>
                        <div class="dental_gallery_count"><span>Occl</span><field name="image_count_occl" nolabel="1"/></div>
                        <div class="dental_gallery_count"><span>Various</span><field name="image_count_various" nolabel="1"/></div>
                        <div class="dental_gallery_count"><span>Hygiene</span><field name="image_count_hygiene" nolabel="1"/></div>
                        <div class="dental_gallery_count"><span>Library</span><field name="image_count_library" nolabel="1"/></div>
                    </div>

                    <notebook>
                        <page string="All">
                            <field name="image_ids" mode="kanban" context="{'default_patient_id': id}">
                                <kanban default_order="date desc, id desc" create="1">
                                    <field name="image_thumb"/>
                                    <field name="date"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="dental_image_card oe_kanban_global_click">
                                                <field name="image_thumb" widget="image" options="{'size': [300, 220]}"/>
                                                <div class="dental_image_date"><field name="date"/></div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Start">
                            <field name="image_start_ids" mode="kanban" context="{'default_category': 'start', 'default_patient_id': id}">
                                <kanban default_order="date desc, id desc" create="1">
                                    <field name="image_thumb"/><field name="date"/>
                                    <templates><t t-name="card"><div class="dental_image_card oe_kanban_global_click"><field name="image_thumb" widget="image" options="{'size': [300, 220]}"/><div class="dental_image_date"><field name="date"/></div></div></t></templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Progress">
                            <field name="image_progress_ids" mode="kanban" context="{'default_category': 'progress', 'default_patient_id': id}">
                                <kanban default_order="date desc, id desc" create="1">
                                    <field name="image_thumb"/><field name="date"/>
                                    <templates><t t-name="card"><div class="dental_image_card oe_kanban_global_click"><field name="image_thumb" widget="image" options="{'size': [300, 220]}"/><div class="dental_image_date"><field name="date"/></div></div></t></templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Retention">
                            <field name="image_retention_ids" mode="kanban" context="{'default_category': 'retention', 'default_patient_id': id}">
                                <kanban default_order="date desc, id desc" create="1">
                                    <field name="image_thumb"/><field name="date"/>
                                    <templates><t t-name="card"><div class="dental_image_card oe_kanban_global_click"><field name="image_thumb" widget="image" options="{'size': [300, 220]}"/><div class="dental_image_date"><field name="date"/></div></div></t></templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Models">
                            <field name="image_models_ids" mode="kanban" context="{'default_category': 'models', 'default_patient_id': id}">
                                <kanban default_order="date desc, id desc" create="1">
                                    <field name="image_thumb"/><field name="date"/>
                                    <templates><t t-name="card"><div class="dental_image_card oe_kanban_global_click"><field name="image_thumb" widget="image" options="{'size': [300, 220]}"/><div class="dental_image_date"><field name="date"/></div></div></t></templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="PAN">
                            <field name="image_pan_ids" mode="kanban" context="{'default_category': 'pan', 'default_patient_id': id}">
                                <kanban default_order="date desc, id desc" create="1">
                                    <field name="image_thumb"/><field name="date"/>
                                    <templates><t t-name="card"><div class="dental_image_card oe_kanban_global_click"><field name="image_thumb" widget="image" options="{'size': [300, 220]}"/><div class="dental_image_date"><field name="date"/></div></div></t></templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="CEPH">
                            <field name="image_ceph_ids" mode="kanban" context="{'default_category': 'ceph', 'default_patient_id': id}">
                                <kanban default_order="date desc, id desc" create="1">
                                    <field name="image_thumb"/><field name="date"/>
                                    <templates><t t-name="card"><div class="dental_image_card oe_kanban_global_click"><field name="image_thumb" widget="image" options="{'size': [300, 220]}"/><div class="dental_image_date"><field name="date"/></div></div></t></templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Occl">
                            <field name="image_occl_ids" mode="kanban" context="{'default_category': 'occl', 'default_patient_id': id}">
                                <kanban default_order="date desc, id desc" create="1">
                                    <field name="image_thumb"/><field name="date"/>
                                    <templates><t t-name="card"><div class="dental_image_card oe_kanban_global_click"><field name="image_thumb" widget="image" options="{'size': [300, 220]}"/><div class="dental_image_date"><field name="date"/></div></div></t></templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Various">
                            <field name="image_various_ids" mode="kanban" context="{'default_category': 'various', 'default_patient_id': id}">
                                <kanban default_order="date desc, id desc" create="1">
                                    <field name="image_thumb"/><field name="date"/>
                                    <templates><t t-name="card"><div class="dental_image_card oe_kanban_global_click"><field name="image_thumb" widget="image" options="{'size': [300, 220]}"/><div class="dental_image_date"><field name="date"/></div></div></t></templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Hygiene">
                            <field name="image_hygiene_ids" mode="kanban" context="{'default_category': 'hygiene', 'default_patient_id': id}">
                                <kanban default_order="date desc, id desc" create="1">
                                    <field name="image_thumb"/><field name="date"/>
                                    <templates><t t-name="card"><div class="dental_image_card oe_kanban_global_click"><field name="image_thumb" widget="image" options="{'size': [300, 220]}"/><div class="dental_image_date"><field name="date"/></div></div></t></templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Library">
                            <field name="image_library_ids" mode="kanban" context="{'default_category': 'library', 'default_patient_id': id}">
                                <kanban default_order="date desc, id desc" create="1">
                                    <field name="image_thumb"/><field name="date"/>
                                    <templates><t t-name="card"><div class="dental_image_card oe_kanban_global_click"><field name="image_thumb" widget="image" options="{'size': [300, 220]}"/><div class="dental_image_date"><field name="date"/></div></div></t></templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Patient Info">
                            <group>
                                <group>
                                    <field name="first_name"/>
                                    <field name="middle_name"/>
                                    <field name="last_name"/>
                                    <field name="sex"/>
                                    <field name="birthdate"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                </group>
                                <group>
                                    <field name="city_id"/>
                                    <field name="address"/>
                                    <field name="race_id"/>
                                    <field name="class_id"/>
                                    <field name="class_notes"/>
                                    <field name="referring_doctor_id"/>
                                    <field name="comments"/>
                                </group>
                            </group>
                        </page>
                        <page string="Visits">
                            <field name="visit_ids">
                                <list editable="bottom">
                                    <field name="visit_date"/>
                                    <field name="treating_doctor_id"/>
                                    <field name="notes"/>
                                </list>
                                <form string="Visit">
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="visit_date"/>
                                                <field name="treating_doctor_id"/>
                                            </group>
                                            <group><field name="notes"/></group>
                                        </group>
                                        <field name="line_ids">
                                            <list editable="bottom">
                                                <field name="stage_diagnosis"/>
                                                <field name="procedure"/>
                                                <field name="notes"/>
                                            </list>
                                        </field>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_dental_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">dental.patient</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_dental_patient_search"/>
    </record>

    <menuitem id="menu_dental_clinic" name="Dental Clinic" sequence="10"/>
    <menuitem id="menu_dental_patient" name="Patients" parent="menu_dental_clinic" action="action_dental_patient" sequence="10"/>
</odoo>
